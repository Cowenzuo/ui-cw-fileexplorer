{
    "name":  "@dsh-plugins/ui-cw-fileexplorer",
    "description":  "Read-only, real-time file explorer view for the dsh web conversation area",
    "version":  "0.1.0-rc1",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**/*",
                  "cordis.patch.yml"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "connection",
                                              "locale",
                                              "runtime",
                                              "ui-slots",
                                              "ui-primitives",
                                              "api-remotes",
                                              "typert-protocol",
                                              "typert-registry",
                                              "host-apiproxy",
                                              "ui-layout"
                                          ],
                               "platform":  "web"
                           }
            },
    "license":  "MIT",
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-client-connection":  "0.1.1-rc.2",
                             "@deepseek-ai/dsh-host-apiproxy":  "0.1.1-rc.2"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@types/node":  "^22.20.0",
                            "@types/react":  "^19.2.18",
                            "react":  "^19.2.8",
                            "tsdown":  "0.22.2",
                            "typescript":  "^6.0.3",
                            "vitest":  "4.1.8",
                            "lightningcss":  "1.32.0",
                            "clsx":  "^2.0.0"
                        },
    "scripts":  {
                    "build":  "tsdown --config tsdown.config.ts",
                    "build:watch":  "tsdown --config tsdown.config.ts --watch",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run"
                }
}